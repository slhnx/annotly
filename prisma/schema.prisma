datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  active
  in_review
  completed
  archived
}

enum ReviewAccess {
  public
  paused
}

enum AnnotationStatus {
  open
  in_progress
  resolved
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects    Project[]
  annotations Annotation[]
  replies     AnnotationReply[]

  @@map("users")
}

model Project {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  websiteUrl     String        @map("website_url")
  description    String?
  status         ProjectStatus @default(active)
  reviewAccess   ReviewAccess  @default(public) @map("review_access")
  reviewCanvasId String        @unique @map("review_canvas_id")

  // Rollup activity & triage summary metrics
  activeReviews    Int      @default(1) @map("active_reviews")
  totalComments    Int      @default(0) @map("total_comments")
  openComments     Int      @default(0) @map("open_comments")
  resolvedComments Int      @default(0) @map("resolved_comments")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  canvases    Canvas[]
  annotations Annotation[]

  @@index([userId])
  @@map("projects")
}

model Canvas {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token        String       @unique
  name         String       @default("Main Review Canvas")
  url          String
  reviewAccess ReviewAccess @default(public) @map("review_access")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  annotations Annotation[]

  @@index([projectId])
  @@map("canvases")
}

model Annotation {
  id        String   @id @default(cuid())
  canvasId  String   @map("canvas_id")
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Author identity: registered user OR guest reviewer
  userId      String? @map("user_id")
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")

  // Pin location & selector resilience (5-tier selector engine)
  elementSelector    String  @map("element_selector")
  elementXPath       String? @map("element_xpath")
  elementTag         String? @map("element_tag")
  elementTextSnippet String? @map("element_text_snippet")

  // Element-relative percentage coordinates (0.0 to 100.0)
  offsetX Float @map("offset_x")
  offsetY Float @map("offset_y")

  // Reviewer environment & viewport context
  viewportWidth    Int     @map("viewport_width")
  viewportHeight   Int     @map("viewport_height")
  devicePixelRatio Float   @default(1.0) @map("device_pixel_ratio")
  browser          String?
  os               String?

  // Feedback content & lifecycle
  content       String
  status        AnnotationStatus @default(open)
  screenshotUrl String?          @map("screenshot_url")
  resolvedAt    DateTime?        @map("resolved_at")
  resolvedBy    String?          @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  replies AnnotationReply[]

  @@index([canvasId])
  @@index([projectId])
  @@index([status])
  @@index([userId])
  @@map("annotations")
}

model AnnotationReply {
  id           String     @id @default(cuid())
  annotationId String     @map("annotation_id")
  annotation   Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  // Author identity: registered user OR guest reviewer
  userId      String? @map("user_id")
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")

  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([annotationId])
  @@index([userId])
  @@map("annotation_replies")
}
