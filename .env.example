# Annotly Environment Variables Configuration
# Copy this file to .env.local for local development

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & Storage (Configured in Phase 2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection via Prisma (Configured in Phase 2)
DATABASE_URL=postgresql://postgres:password@localhost:5432/annotly?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/annotly?schema=public
